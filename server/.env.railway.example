# Railway sets these automatically from the managed services:
DATABASE_URL=         # auto-set by Railway PostgreSQL plugin
REDIS_URL=            # auto-set by Railway Redis plugin

# Set these manually in Railway dashboard → Variables:
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://adearn.vercel.app

REDIS_PREFIX=adearn:

# Generate with: openssl genrsa 2048 | base64 -w0
JWT_PRIVATE_KEY=      # RSA-2048 private key (PEM, base64-encoded for single-line)
JWT_PUBLIC_KEY=       # RSA-2048 public key (PEM, base64-encoded)
JWT_EXPIRES_IN=24h

STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

OTP_MOCK=false
OTP_EXPIRY_SECONDS=120

EMAIL_MOCK=false

CASHBACK_MAX_PER_TRANSACTION=500
CASHBACK_MIN_PER_TRANSACTION=1
FRAUD_SCORE_THRESHOLD=0.8
ATTRIBUTION_WINDOW_HOURS=24

SENTRY_DSN=https://...@sentry.io/...
